{
  "name": "edyfra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "vercel-build": "next build",
    "start": "next start",
    "dev:python": "uvicorn backend.fastapi_app:app --reload --port 8000",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:python\"",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:15": "node scripts/run-migration.mjs supabase/migrations/15_institution_v2_system.sql",
    "changelog": "powershell -File scripts/changelog.ps1",
    "changelog:new": "powershell -File scripts/changelog.ps1 -Message",
    "changelog:generate": "node scripts/generate-changelog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
