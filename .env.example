# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local and fill in
# the values provided by your team lead.
# ==========================================

# Public variables (client-side accessible)
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=
DIRECT_URL=

# Admin / Service credentials
SERVICE_ROLE_KEY=
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_SECRET_KEY=
CRON_SECRET=

# AI / External APIs
AI_API_KEY=
GOOGLE_AI_KEY=
PROJECT_NUMBER=

# Communications
EMAIL_API_KEY=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# Real-time / Chat / Video
CHAT_API_KEY=
CHAT_SECRET_KEY=
VIDEO_API_KEY=
VIDEO_SECRET_KEY=

# Rate limiting
REDIS_URL=
REDIS_TOKEN=

# Payments
PAYMENT_CONSUMER_KEY=
PAYMENT_CONSUMER_SECRET=
PAYMENT_PASSKEY=
PAYMENT_SHORTCODE=
PAYMENT_CALLBACK_URL=
PAYMENT_ENV=sandbox
PAYMENT_B2C_SECURITY_CREDENTIAL=
