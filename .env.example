# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local and fill in
# the values provided by your team lead.
# ==========================================

# Public variables (client-side accessible)
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Supabase (auth + database). Required by every sign-in path, including
# "Continue with Google". Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=
DIRECT_URL=

# Admin / Service credentials
SERVICE_ROLE_KEY=
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_SECRET_KEY=
CRON_SECRET=

# AI / External APIs
AI_API_KEY=
GOOGLE_AI_KEY=
PROJECT_NUMBER=

# Communications
EMAIL_API_KEY=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# Google sign-in runs through Supabase's OAuth broker, so the Google client id
# and secret are NOT read by this app at runtime — they are configured in the
# Supabase dashboard (Authentication -> Providers -> Google).
#
# Google Cloud Console -> OAuth client -> Authorized redirect URIs must contain
# the Supabase broker callback for YOUR project:
#   https://<project-ref>.supabase.co/auth/v1/callback
#
# Supabase -> Authentication -> URL Configuration -> Redirect URLs must contain:
#   https://<your-domain>/auth/callback
#
# GOOGLE_CLIENT_ID is used only as a flag: when it is absent the "Continue with
# Google" button is hidden. Set it to the same client id configured in Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar OAuth (tutor calendar sync) — a separate Google client that
# this app DOES exchange directly, via GOOGLE_OAUTH_* below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=

# Real-time / Chat / Video
CHAT_API_KEY=
CHAT_SECRET_KEY=
VIDEO_API_KEY=
VIDEO_SECRET_KEY=

# Rate limiting
REDIS_URL=
REDIS_TOKEN=

# Payments
PAYMENT_CONSUMER_KEY=
PAYMENT_CONSUMER_SECRET=
PAYMENT_PASSKEY=
PAYMENT_SHORTCODE=
PAYMENT_CALLBACK_URL=
PAYMENT_ENV=sandbox
PAYMENT_B2C_SECURITY_CREDENTIAL=

# Python Backend (FastAPI on Railway)
# Get this URL from your Railway project dashboard after deploying the backend/ folder.
# Example: https://edyfra-python.up.railway.app
PYTHON_BACKEND_URL=

# Extra CORS origins for the Python backend (comma-separated, optional)
# Add preview deploy URLs here if you have them.
CORS_ORIGINS=

# --- AI (OpenRouter) ---------------------------------------------
# All platform AI (Mash, Eddy, insights, challenge gen, institution AI)
# routes through OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: default model override (must be an OpenRouter model id, e.g. google/gemini-2.0-flash-001)
AI_MODEL=

# --- Vercel (admin AI-settings live env sync) --------------------
# Lets the admin AI Settings page push OPENROUTER_API_KEY straight to Vercel.
# Create a token at https://vercel.com/account/tokens (scope: the Edyfra project).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
