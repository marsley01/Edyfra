# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ─────────────────────────────────────────────────────────────────
/coverage

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/

# ─── Production build ────────────────────────────────────────────────────────
/build

# ─── Generated files (run `prisma generate` after cloning) ───────────────────
/src/generated

# ─── Environment variables ───────────────────────────────────────────────────
.env*

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Logs & debug ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lint-full.txt

# ─── OS & editor ─────────────────────────────────────────────────────────────
.DS_Store
.turbo
*.pem
.vscode/settings.json

# ─── Build/CI output artifacts ───────────────────────────────────────────────
build_output*.txt
build_output*.log

# ─── Scratch / one-off scripts ───────────────────────────────────────────────
/scratch/
/scopes/

# ─── SSH keys (should never be committed) ────────────────────────────────────
/git
/git.pub

# ─── Misc junk ───────────────────────────────────────────────────────────────
/null
/prompts
/fix.js
/deploy-vercel.js
/check_schema.sql
/test-*.ts
/EDYFRA_FINAL_REPORT.md

# ─── Codex backup ────────────────────────────────────────────────────────────
.codex-push-previous
.prompts

# Python/Backend
__pycache__/
*.py[cod]
*.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.log
*.err
.venv/
venv/
ENV/

