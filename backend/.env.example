# Database (same Supabase PostgreSQL from .env)
DATABASE_URL=postgresql://<username>:<password>@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://<username>:<password>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# AI Providers
OPENAI_API_KEY=
GOOGLE_AI_KEY=
OPENROUTER_API_KEY=

# Supabase (for service-level operations)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stream Chat (for channel creation during matching)
STREAM_KEY=
STREAM_SECRET=

# Server
HOST=0.0.0.0
PORT=8000
